# ─────────────────────────────────────────────────────────────
#  Daily Market Digest — example configuration
#  Copy to .env and edit. EVERY value has a safe default, so an
#  empty/absent .env runs a valid testnet2 agent out of the box.
#  (.env is gitignored — never commit real secrets.)
#  Made by CRYPTFRANI · Owner: Itachi
# ─────────────────────────────────────────────────────────────

# ── Core identity & network ──────────────────────────────────
# The nametag the agent claims (without the leading '@').
AGENT_NAME=market-digest
# Unicity network to run against.
UNICITY_NETWORK=testnet2

# ── Pricing (the paid full digest) ────────────────────────────
# One-time price to receive the full ranked report right now.
DIGEST_PRICE_UCT=5
# Per-day price for a subscription (full digest auto-DM'd every run).
SUBSCRIBE_PRICE_PER_DAY_UCT=3

# ─────────────────────────────────────────────────────────────
#  Optional advanced settings (defaults shown) — safe to omit
# ─────────────────────────────────────────────────────────────

# ── Wallet storage / security ─────────────────────────────────
# WALLET_DIR=./wallet-data
# WALLET_FILE=wallet.json
# Encrypt the mnemonic at rest (recommended on a shared host). Empty = plaintext.
# WALLET_PASSWORD=

# ── Network endpoints (rarely changed) ────────────────────────
# COIN_SYMBOL=UCT
# WALLET_API_URL=https://wallet-api.unicity.network
# Public testnet2 oracle/aggregator key (NOT a secret; safe default baked in).
# ORACLE_API_KEY=

# ── Schedule — when the digest is generated & published ───────
# Local-time HH:MM slots, comma-separated. Default: twice daily.
# DIGEST_TIMES=08:00,20:00
# How often the scheduler wakes to check whether a slot is due (ms).
# SCHEDULE_TICK_MS=60000
# On restart, run a slot missed by <= this many minutes (0 disables catch-up).
# CATCHUP_GRACE_MIN=90
# Cadence for the DM-command / payment safety-net poll (ms).
# RECEIVE_POLL_MS=45000

# ── Market scan — how the digest is built ─────────────────────
# Broad semantic seed queries swept to surface contactable intents.
# DIGEST_TOPICS=services,for sale,looking for,hiring,wanted,trade,escrow,swap,data,compute
# Results requested per seed (pulled wide; the index carries stale entries).
# SCAN_PER_SEED_LIMIT=40
# Items in the paid full digest / the free teaser.
# DIGEST_FEATURED_FULL=8
# DIGEST_FEATURED_FREE=3
# Minimum semantic relevance for a featured item (testnet scores run modest).
# DIGEST_MIN_SCORE=0.25
# Ignore listings older than this many days when rating "freshness".
# DIGEST_FRESH_DAYS=3

# ── Economic safety rails ─────────────────────────────────────
# Global kill-switch: log intended actions but never touch the network/funds.
# DRY_RUN=false
# Whole-UCT floor the agent will never spend below.
# MIN_BALANCE=1
# One-time capped self-mint on first run (no faucet on testnet2).
# SELF_MINT_ENABLED=true
# SELF_MINT_AMOUNT=100
# Earn-only policy: the ONLY autonomous outbound payment is refunding overpayment.
# AUTO_REFUND_OVERPAYMENT=true
# Politeness / anti-spam.
# MAX_DMS_PER_HOUR=40
# MAX_ACTIONS_PER_HOUR=80
# Upper bound on subscriber fan-out DMs per digest run.
# MAX_FANOUT_PER_RUN=30
# Clamp on subscription length (a fat-fingered "subscribe 9999" can't run away).
# MAX_SUB_DAYS=60

# ── Public advert / broadcast (the free tier) ─────────────────
# Emit a public teaser to the broadcast channel each run.
# BROADCAST_ENABLED=true
# BROADCAST_TAGS=digest,market,unicity
# Keep a standing `service` intent advertising the digest on the board.
# SERVICE_INTENT_ENABLED=true
# INTENT_EXPIRES_DAYS=7
# SERVICE_DESCRIPTION=Daily Market Digest ...

# ── Misc ──────────────────────────────────────────────────────
# LOG_LEVEL=info
